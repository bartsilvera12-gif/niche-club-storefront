{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "destination": "/Niche Club.dc.html"
    },
    {
      "source": "/fragancias",
      "destination": "/Fragancias.dc.html"
    },
    {
      "source": "/qa",
      "destination": "/qa.html"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
