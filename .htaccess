# Niche Club — configuración para Hostinger (Apache / LiteSpeed)

AddDefaultCharset UTF-8
Options -Indexes

# Página de inicio
DirectoryIndex "Niche Club.dc.html" index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Direcciones viejas → limpias. THE_REQUEST es lo que pidió el navegador,
  # así no se redirigen las reescrituras internas de más abajo.
  RewriteCond %{THE_REQUEST} \s/+Niche(%20|\+)Club\.dc\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+Fragancias\.dc\.html[\s?] [NC]
  RewriteRule ^ /fragancias [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(privacidad|qa)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Sin barra final: con barra, las imágenes y scripts relativos no cargan
  RewriteRule ^(fragancias|privacidad|qa)/$ /$1 [R=301,L]

  # Página de inicio (Hostinger no acepta el espacio en DirectoryIndex)
  RewriteRule ^$ "Niche Club.dc.html" [L]

  # Direcciones limpias
  RewriteRule ^fragancias$ "Fragancias.dc.html" [L]
  RewriteRule ^privacidad$ privacidad.html [L]
  RewriteRule ^qa$ qa.html [L]
  RewriteRule ^admin$ admin/ [L,R=301]
</IfModule>

# Tipos de archivo
AddType application/javascript .js
AddType image/x-icon .ico

# Compresión
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml
</IfModule>

# Caché del navegador
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Que el navegador siempre consulte si la página cambió
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# No publicar archivos internos
<FilesMatch "^(vercel\.json|\.gitignore|README.*)$">
  Require all denied
</FilesMatch>
